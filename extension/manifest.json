{
  "manifest_version": 3,
  "name": "EduDev Comments",
  "version": "0.1.0",
  "description": "Genera comentarios profesionales para publicaciones de LinkedIn con un modelo local.",
  "key": "",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8788/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "EduDev Comments"
  }
}
